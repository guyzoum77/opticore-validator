{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "module": "ESNext",
    "target": "ES2024",
    "moduleResolution": "bundler",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "dist",
    "allowJs": true
  },
  "include": ["src/**/*.ts", "bin/**/*.ts"],
  "exclude": ["node_modules"]
}