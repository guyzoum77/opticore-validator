{
  "name": "opticore-validator",
  "version": "1.1.0",
  "description": "Validator schema with many rule, and custom message",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opticore-validator": "dist/opticoreValidator.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "dev:cli": "tsx bin/opticoreValidator.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyzoum77/opticore-validator.git"
  },
  "author": "Guy-serge Kouacou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guyzoum77/opticore-validator/issues"
  },
  "homepage": "https://github.com/guyzoum77/opticore-validator#readme",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@types/gradient-string": "^1.1.6",
    "ansi-colors": "^4.1.3",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "date-fns": "^4.4.0",
    "fs-extra": "^11.3.4",
    "gradient-string": "^3.0.0",
    "opticore-express": "^1.0.9",
    "opticore-http-response": "^1.0.11",
    "path": "^0.12.7",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.2"
  }
}
