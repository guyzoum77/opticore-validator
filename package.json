{
  "name": "opticore-validator",
  "version": "1.0.10",
  "description": "Validator schema with many rule, and custom message",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.mts",
        "default": "./dist/cli.mjs"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./dist/cli.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "opticore-validator": "dist/opticoreValidator.cjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "tsdown",
    "dev:cli": "tsx bin/opticoreValidator.ts",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guyzoum77/opticore-validator.git"
  },
  "author": "Guy-serge Kouacou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guyzoum77/opticore-validator/issues"
  },
  "homepage": "https://github.com/guyzoum77/opticore-validator#readme",
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "ansi-colors": "^4.1.3",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "date-fns": "^4.4.0",
    "fs-extra": "^11.4.1",
    "opticore-express": "^1.0.9",
    "opticore-http-response": "^1.0.13"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
